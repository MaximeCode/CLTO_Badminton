{
  "kind": "collectionType",
  "collectionName": "interclub_teams",
  "info": {
    "singularName": "interclub-team",
    "pluralName": "interclub-teams",
    "displayName": "Interclub Team",
    "description": "Données interclubs scrapées depuis IcBAD — classement + rencontres par équipe"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "teamLabel": {
      "type": "string",
      "required": true
    },
    "teamSlug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "desc": {
      "type": "text"
    },
    "objectif": {
      "type": "string"
    },
    "division": {
      "type": "enumeration",
      "required": true,
      "unique": true,
      "enum": [
        "N1",
        "N2",
        "N3",
        "R1",
        "R2",
        "R3",
        "D1-A",
        "D1-B",
        "D2-A",
        "D2-B",
        "D3",
        "D4"
      ]
    },
    "icbadUrl": {
      "type": "string",
      "required": true
    },
    "icbadTeamCode": {
      "type": "string"
    },
    "competitionName": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "ranking": {
      "type": "json"
    },
    "cltoPosition": {
      "type": "integer"
    },
    "cltoPoints": {
      "type": "integer"
    },
    "cltoPlayed": {
      "type": "integer"
    },
    "cltoWon": {
      "type": "integer"
    },
    "cltoDraw": {
      "type": "integer"
    },
    "cltoLost": {
      "type": "integer"
    },
    "cltoBonusPlus": {
      "type": "integer"
    },
    "cltoBonusMinus": {
      "type": "integer"
    },
    "cltoMatchDiff": {
      "type": "integer"
    },
    "cltoSetDiff": {
      "type": "integer"
    },
    "cltoPtsDiff": {
      "type": "integer"
    },
    "matches": {
      "type": "json"
    },
    "bonuses": {
      "type": "json"
    },
    "lastScrapedAt": {
      "type": "datetime"
    },
    "scrapeError": {
      "type": "string"
    }
  }
}
